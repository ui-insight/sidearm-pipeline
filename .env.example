# ==============================================================================
# Vandals Stats Pipeline — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit the .env file to version control.
# ==============================================================================

# --- Database ---
# Standard local/deployed database (PostgreSQL):
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# Optional SQLite fallback for isolated experiments only:
# DATABASE_URL=sqlite+aiosqlite:///./app.db

# --- Authentication ---
# IMPORTANT: Change this in production. The app will refuse to start in
# production mode with the default key.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Prototype access gate ---
# Enable only when shared credentials are supplied by the deployment environment.
PROTOTYPE_AUTH_ENABLED=false
PROTOTYPE_AUTH_USERNAME=prototype
PROTOTYPE_AUTH_PASSWORD=
# Comma-separated prototype roles. Style Guide writes require style_steward.
PROTOTYPE_AUTH_ROLES=sid_editor,publisher,style_steward,channel_administrator

# --- Application ---
DEV_MODE=true
UPLOAD_DIR=./uploads
# JSON array or comma-separated list of absolute HTTP(S) origins.
# Wildcard origins are rejected when DEV_MODE=false.
CORS_ORIGINS=["http://localhost:5173","http://localhost:9200"]

# --- Rate limiting (optional starter middleware) ---
# Keep disabled by default for local development. For public deployments,
# prefer coarse limits at the reverse proxy or platform edge and use the app
# middleware only when you need request-aware limits in the backend.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Only enable this when a trusted proxy strips/sanitizes X-Forwarded-For.
RATE_LIMIT_TRUST_PROXY_HEADERS=false
# JSON array or comma-separated list of exempt path prefixes.
RATE_LIMIT_EXEMPT_PATHS=["/api/v1/health","/api/v1/ready"]

# --- Sidearm source fetch policy ---
# Timeout and retry behavior for Sidearm HTML fetches.
SIDEARM_REQUEST_TIMEOUT_SECONDS=20
SIDEARM_FETCH_MAX_ATTEMPTS=3
SIDEARM_FETCH_BACKOFF_SECONDS=0.5

# --- AI Services (optional) ---
# Used by the legacy content generator, Achievement ranking, semantic questions,
# and the evidence-bound Article writer.
# Point at either Anthropic directly OR the University of Idaho MindRouter
# gateway (https://mindrouter.uidaho.edu/documentation) — both speak the
# Anthropic Messages API.
#
# Option A — Anthropic direct:
# ANTHROPIC_API_KEY=sk-ant-...
# CONTENT_MODEL=claude-opus-4-7
#
# Option B — University of Idaho MindRouter:
# ANTHROPIC_API_KEY=<your MindRouter key>
# ANTHROPIC_BASE_URL=https://mindrouter.uidaho.edu/anthropic
# CONTENT_MODEL=<pick a model listed at GET /v1/models on MindRouter>
# ARTICLE_MODEL=<optional; defaults to CONTENT_MODEL>
# ARTICLE_GENERATION_MAX_TOKENS=4000
# ARTICLE_GENERATION_POLL_SECONDS=2
# ARTICLE_GENERATION_LEASE_SECONDS=300
# ACHIEVEMENT_MODEL=<pick a model listed at GET /v1/models on MindRouter>
# ACHIEVEMENT_AI_MAX_CANDIDATES=100
# NLQ_MODEL=<optional; defaults to ACHIEVEMENT_MODEL>
